# FastAPI Configuration
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://redis:6379/0

# Keycloak Authentication JWKS
KEYCLOAK_JWKS_URL=https://auth.apeworker.top/realms/apeworker/protocol/openid-connect/certs

# Upload Post API Key (get from https://upload-post.com)
UPLOAD_POST_API_KEY=your_upload_post_api_key_here

# Google Gemini API Key (optional, get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
