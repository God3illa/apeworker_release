# ApeWorker SMM Configuration

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated list of allowed Telegram user IDs (e.g. 123456789,987654321). Leave empty to allow all.
TELEGRAM_ALLOWED_USERS=

# Upload Post API Key (get from https://upload-post.com)
UPLOAD_POST_API_KEY=your_upload_post_api_key_here

# Google Gemini API Key for AI rewriting (optional, get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
